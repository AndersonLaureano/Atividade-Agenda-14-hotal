<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.QuartosDisponiveis"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F7F5F0">

    <ScrollView>
        <VerticalStackLayout Padding="24,30"
                             Spacing="22"
                             HorizontalOptions="Center">

            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="52,*"
                  ColumnSpacing="13">

                <Border Grid.Column="0"
                        BackgroundColor="#243B53"
                        StrokeThickness="0"
                        HeightRequest="52"
                        WidthRequest="52"
                        Padding="0"
                        StrokeShape="RoundRectangle 14">

                    <Label Text="A"
                           FontSize="29"
                           FontAttributes="Bold"
                           TextColor="#D9B77E"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>

                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="AURORA HOTEL"
                           FontSize="21"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="#243B53"/>

                    <Label Text="HOSPEDAGEM E CONFORTO"
                           FontSize="9"
                           CharacterSpacing="1.5"
                           TextColor="#A18455"/>

                </VerticalStackLayout>

            </Grid>

            <BoxView HeightRequest="1"
                     Color="#E5DED2"/>

            <!-- TÍTULO -->
            <VerticalStackLayout Spacing="7">

                <Label Text="NOSSAS ACOMODAÇÕES"
                       FontSize="11"
                       CharacterSpacing="2"
                       FontAttributes="Bold"
                       TextColor="#A18455"/>

                <Label Text="Escolha sua suíte"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="#243B53"/>

                <Label Text="Conheça nossas opções e encontre o espaço ideal para sua estadia."
                       FontSize="14"
                       TextColor="#777D83"/>

            </VerticalStackLayout>

            <!-- LISTA DE QUARTOS -->
            <VerticalStackLayout x:Name="ListaQuartos"
                                 Spacing="15"/>

           <!-- IMAGEM DECORATIVA -->
<Border StrokeThickness="0"
        Padding="0"
        BackgroundColor="Transparent"
        StrokeShape="RoundRectangle 16">

    <Image Source="hotel.jpg"
           HeightRequest="190"
           Aspect="AspectFill"
           HorizontalOptions="Fill"
           VerticalOptions="Fill"/>

</Border>

            <!-- TEXTO ABAIXO DA IMAGEM -->
            <VerticalStackLayout Spacing="5">

                <Label Text="SUA EXPERIÊNCIA COMEÇA AQUI"
                       FontSize="11"
                       CharacterSpacing="1.5"
                       FontAttributes="Bold"
                       TextColor="#A18455"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Conforto, tranquilidade e momentos especiais esperam por você."
                       FontSize="13"
                       TextColor="#777D83"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <!-- BOTÃO VOLTAR -->
            <Button Text="Voltar ao início"
                    HorizontalOptions="Fill"
                    BackgroundColor="#243B53"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="Voltar_Clicked"/>

            <!-- RODAPÉ -->
            <Label Text="AURORA HOTEL • HOSPEDAGEM E CONFORTO"
                   FontSize="9"
                   CharacterSpacing="1"
                   TextColor="#A18455"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,12"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>